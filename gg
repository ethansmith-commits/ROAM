
import os
import sys  # The restart system
import time
import random


def clear_screen():
    """Clears the terminal screen for a cleaner look."""
    os.system('cls' if os.name == 'nt' else 'clear')


def restart_program():
    """Restarts the current program."""
    print("\nRestarting ROAM...")
    time.sleep(1)
    python = sys.executable
    os.execl(python, python, *sys.argv)


def terminal_loading_screen():
    print("Loading application...")
    total_steps = 50

    for i in range(total_steps + 1):
        percent = (i / total_steps) * 100
        bar = "=" * i + " " * (total_steps - i)
        sys.stdout.write(f"\r[{bar}] {percent:.0f}%")
        sys.stdout.flush()
        time.sleep(0.01)  # Speed up slightly for testing
    print("\nLoad complete!")
    time.sleep(0.5)


