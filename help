from playsound import playsound
import os
import sys  # the restart sytem
import time


def clear_screen():
    #Clears the terminal screen for a cleaner look.
    os.system('cls' if os.name == 'nt' else 'clear')


def restart_program():
    #"""Restarts the current program."""
    print("\nRestarting ROAM...")
    time.sleep(1)
    python = sys.executable
    os.execl(python, python, *sys.argv)


def terminal_loading_screen():
    print("Loading application...")
    total_steps = 50

    for i in range(total_steps + 1):
        percent = (i / total_steps) * 100
        bar = "=" * i + " " * (total_steps - i)
        sys.stdout.write(f"\r[{bar}] {percent:.0f}%")
        sys.stdout.flush()
        time.sleep(0.03)  # Speed up slightly for testing
    print("\nLoad complete!")
    time.sleep(0.5)



# Get user details
username = input("Enter username you would like to be referred to\nwhen interacting with NPCs: ")
age = int(input("Enter your age must use number or game will not run : "))
pegi = 16

# Check age rating
if age < pegi:
    print("You are too young! Exiting game...")
    sys.exit()  # Safely closes the program





if __name__ == "__main__":
    terminal_loading_screen()

