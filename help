def game_over():
    return (r"""
 ╔┌═┐╗ ╔┌═┐╗ ╔┌┐╔┐╗ ╔┌═┐╗      ╔┌═┐╗ ╔┐ ┌╗ ╔┌═┐╗ ╔═─╗ 
║│┌═╗ ║╚═╝║ ║│└╝│║ ║╚╗└╝      ║│ │║ ║│ │║ ║╚╗└╝ ║╚─╚╗
║│ │║ ║│ │║ ║│  │║ ║│ ┌╗      ║│ │║ └│┌│┘ ║│ ┌╗ ║┌═┐║
╚└═┘╝ ╚╝ ╚╝ ╚┘  └╝ ╚└═┘╝      ╚└═┘╝  └╝┘  ╚└═┘╝ ╚╝ ╚╝   
""")


def display_level_art(level):
    if level == 1:
        print(show_level1())
    elif level == 2:
        print(show_level2())
    elif level == 3:
        print(show_level3())
    elif level == 4:
        print(show_level4())
    else:
        print(show_level5())



def display_hero(Race, username, lore, strengths, weaknesses, signature, ascii_art):
    print("\n" + "=" * 60)
    print(ascii_art)
    print("=" * 60)
    print(f"👤 PROFILE FOR: {username.upper()}")
    print(f"🧬 RACE:         {Race.upper()}")
    print(f"📖 LORE:         {lore}")
    print(f"⚔️ STRENGTHS:    {strengths}")
    print(f"❌ WEAKNESSES:   {weaknesses}")
    print(f"💫 SIGNATURE:    {signature}")
    print("=" * 60)

class RPGGameEngine:
    def __init__(self, username, profile):
        self.username = username
        self.player_race = profile["race"]
        self.signature = profile["signature"]

        # Level is a number. Area is a separate string.
        self.current_level = 1
        self.current_area = "Sector 1 - Command Hub"

        self.max_hp = profile["hp"]
        self.hp = self.max_hp

        self.max_energy = profile["energy"]
        self.energy = self.max_energy

        self.credits = 100
        self.boss_defeated_for_current_level = False
        self.game_over = False

def pause():
    input("\nPress Enter to continue...")



    def roll_dice(self, sides):
        return random.randint(1, sides)

    def combat_roll(self, is_boss_fight=False):
        """
        Combat Rolls using your strict D8 core mechanics.
        """
        roll = self.roll_dice(8)
        # Cap out non-boss instances at 6 as requested by rules
        effective_roll = roll if is_boss_fight else min(6, roll)

        result = f"Combat Roll: {roll} -> "
        if effective_roll <= 2:
            return effective_roll, result + "Miss / enemy hits! You take damage."
        elif effective_roll <= 4:
            return effective_roll, result + "Normal hit dealt."
        elif effective_roll == 5:
            return effective_roll, result + "Strong hit dealt!"
        elif effective_roll == 6:
            return effective_roll, result + "Critical hit + ability trigger activated!"
        elif effective_roll >= 7:
            return effective_roll, result + "Boss fight specific shift triggered!"

    def exploration_roll(self):
        """Exploration rules bracket splits (D8)"""
        roll = self.roll_dice(8)
        result = f"Exploration Roll: {roll} -> "
        if roll <= 3:
            return result + "Low roll: Hazard or enemy encounter!"
        elif roll <= 5:
            return result + "Mid roll: Neutral event finding an NPC."
        else:
            return result + "High roll: Rare item, creature, or lore discovered!"

    def dialogue_roll(self):

        roll = self.roll_dice(8)
        final_roll = max(1, min(8, roll ))
        result = f"Dialogue Roll: {roll} (Final: {final_roll}) -> "

        if final_roll <= 2:
            result += "NPC distrusts you and engages combat!"
        elif final_roll <= 4:
            result += "Neutral stance achieved."
        elif final_roll <= 6:
            result += "Success! NPC gives quest item or info."
        elif final_roll == 7:
            result += "Npc guides your direction to a weapon!"
        elif final_roll == 8:
            result += "Npc guides your direction directly to health!"

        return final_roll, result

    def load_and_fight_boss(self, boss_key):
        """Loads and fights boss keys from the dictionary format."""
        boss_database = {
