def display_hero(name, designation, lore, strengths, weaknesses, signature, art_function=None):
    print("\n" + "=" * 60)
    print(f"  HERO PROFILE:   {name}")
    print(f"  DESIGNATION:    {designation}")
    print("=" * 60)

    # Displays ASCII art if the hero has one assigned
    if art_function:
        print(art_function())
        print("=" * 60)

    print(f"BACKGROUND / LORE:\n{lore}\n")
    print(f"STRENGTHS:      {strengths}")
    print(f"WEAKNESSES:     {weaknesses}")
    print(f"SIGNATURE MOVE: {signature}")
    print("=" * 60)
    input("\nPress Enter to return to the character select menu...")

def display_hero(name, lore, strengths, weaknesses, signature):
    print("\n" + "=" * 60)
    print(f"  NAME: {name}")
    print(f"  lore: {lore}")
    print(f"  strengths: {strengths}")
    print(f"  weaknesses: {weaknesses}")
    print(f"  signature: {signature}")
    print("=" * 50)
    input("\nPress Enter to return to the main menu...")

# Menu choice for the hero side
choice_0 = input("Select a Hero profile to view (1-5): ").strip()
match choice_0:
    case "1":
        display_hero(name="human", lore="A descendant of ancient Caribbean guardians. Their teachings are passed down from generation to generation."
                     , strengths="Nature affinity, Diplomacy , Creature bonding, Passive to humans "
                     , weaknesses=" lower tech resistance, Least passive to aliens ,tech attacks"
                     , signature=" soul wave. This allows the user to calm down hostile creatures.")
    case "2":
        display_hero(name="hybrid", lore="Half human ,half extraterrestrial,infused with coral tech."
                     , strengths="really good stats. Able to traverse all lands. Passive to Hybrids"
                     , weaknesses=" Abilities cost more energy, Hated by all except hybrids,Spiritual attack"
                     , signature="Ability: Morph tide- temporally allows the user to become one of the 4 characters temporally.")
    case "3":
        display_hero(name="cyborg", lore="", strengths="", weaknesses="", signature="")
    case "4":
        display_hero(name="alien", lore="", strengths="", weaknesses="", signature="")
    case_:
        print("\n[Invalid option! Please pick a valid hero number.]")



