if __name__ == "__main__":
    terminal_loading_screen()
    clear_screen()

    print("=========================================")
    print(f"           WELCOME TO ROAM, {username.upper()}           ")
    print("=========================================\n")

    # Selection Flow
    print("Select your Origin Species:")
    for key, info in species_data.items():
        print(f" [{key}] {info['name']} - {info['ability']}")
        print(f"     └ {info['description']}")

    choice = input("\nChoose your species index (1-4): ").strip()
    if choice not in species_data:
        print("Invalid alignment choice! Defaulting to Human lineage.")
        choice = "1"

    player_species = species_data[choice]

    # Initialize Player Session Attributes
    player_hp = player_species["hp"]
    player_max_hp = player_species["hp"]
    player_energy = player_species["energy"]
    player_max_energy = player_species["energy"]
    credits = 100
    location = "Sector 0 - Command Hub"
    clear_screen()
    print("--- CHARACTER INITIALISED ---")
    print(f"Name:     {username}")
    print(f"Species:  {player_species['name']}")
    print(f"Trait:    {player_species['ability']}")
    print(f"Health:   {player_hp}/{player_max_hp}")
    print(f"Energy:   {player_energy}/{player_max_energy}")
    print(f"Credits:  {credits} CR")
    print("-----------------------------\n")
    time.sleep(2)

    # --- MAIN ENGINE LOOP ---
    while True:
        if player_hp <= 0:
            print("\n*** CRITICAL FAILURE: Your life signs have flatlined. ***")
            action = input("Press [R] to restart ROAM or [E] to exit: ").lower()
            if action == 'r':
                restart_program()
            else:
                print("Goodbye traveler")
                sys.exit()


class RPGGameEngine:
    def __init__(self, player_race, current_area):
        self.player_race = player_race.lower()
        self.current_area = current_area

    def roll_dice(self, sides):
        return random.randint(1, sides)

    def combat_roll(self, is_boss_fight=False):
        roll = self.roll_dice(20)
        if is_boss_fight:
            roll -= 3
        return max(1, roll)

    def exploration_roll(self):
        return self.roll_dice(10)

    def dialogue_roll(self):
        roll = self.roll_dice(8)
        modifier = 0

        if self.player_race == "alien" and self.current_area == "Trinidad Village":
            modifier = -2
        elif self.player_race == "human" and self.current_area == "Trinidad Village":
            modifier = 1
        elif self.player_race == "hybrid":
            modifier = -1

        final_roll = max(1, min(8, roll + modifier))

        result = f"Dialogue Roll: {roll} (Final: {final_roll} with modifiers) -> "
        if final_roll <= 2:
            result += f"The NPC distrusts you (influenced by your race: {self.player_race} and area: {self.current_area}). COMBAT INITIATED!"
        elif final_roll <= 4:
            result += "Neutral response. The NPC treats you carefully."
        elif final_roll <= 6:
            result += "Success! The NPC gives you a quest item or vital info."
        elif final_roll == 7:
            result += "Great Success! The NPC guides you directly to a new weapon!"
        elif final_roll == 8:
            result += "Perfect Success! The NPC guides you to a hidden stash of supplies!"

        return final_roll, result

