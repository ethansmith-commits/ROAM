print(f"Credits:  {game.credits} CR")
print("-----------------------------\n")
time.sleep(2)

# --- MAIN PLAYABLE GAME LOOP ---
# Setup level pacing dictionary mapping
level_bosses = {
    1: "bloom_tyrant",
    2: "baseline_titan",
    3: "queen_abyssara",
    4: "ember_sovereign",
    5: "rift_monarch"
}
while True:
    # Check death states immediately at top of loop frame
    if game.hp <= 0:
        print("\n*** CRITICAL FAILURE: Your life signs have flatlined. ***")
        action = input("Press [R] to restart ROAM or [E] to exit: ").lower().strip()
        if action == 'r':
            restart_program()
            break
        else:
            print("Goodbye traveler.")
            sys.exit()

    print(f"\n====================== LEVEL {game.current_area} ======================")
    print(f" [1] Roll for Room Exploration (D8)")
    print(f" [2] Approach Area Zone Boss")
    print(f" [3] View Character Vital Vitals")
    print(f" [4] Exit Game")
    print("====================================================")

    turn_choice = input("What will you do? ").strip()

    if turn_choice == "1":
        clear_screen()
        print(game.exploration_roll())
        # Give player some random rewards/penalties to test engine weights
        time.sleep(2)

    elif turn_choice == "2":
        # Target boss string according to the active level number
        active_boss_key = level_bosses.get(game.boss_defeated_for_current_level, "rift_monarch")
        game.load_and_fight_boss(active_boss_key)


        if game.boss_defeated_for_current_level:
            if game.current_area < 5:
                game.current_area += 1
                game.boss_defeated_for_current_level = False  # Reset gate for next zone
                print(f"\n✨ Victory Achievement! Proceeding to Level {game.current_area}...")
            else:
                print("\n🏆 CONGRATULATIONS! You have conquered the Rift Monarch and finished ROAM\n you are now the king of the world and you can decide !")
                sys.exit()
        time.sleep(2)

    elif turn_choice == "3":
        clear_screen()
        print("--- CURRENT STATUS ---")
        print(f"Location:  Level {game.current_area}")
        print(f"Health:    {game.hp}/{game.max_hp} HP")
        print(f"Energy:    {game.energy}/{game.max_energy} EN")
        print(f"Credits:   {game.credits} CR")
        print("----------------------")
        input("\nPress Enter to return...")

    elif turn_choice == "4":
        print("Saving data... Goodbye traveler.")
        sys.exit()

    else:
        print("[Invalid choice! Select a valid menu action number.]")


    def command_centre(self):
        """The core operational loop for the player."""
        while self.hp > 0:
            print("\n" + "=" * 50)
            print(f"📡 COMMAND CENTRE | Location: {self.current_area.upper()}")
            print(
                f"❤️ HP: {self.hp}/{self.max_hp} | ⚡ Energy: {self.energy}/{self.max_energy} | 🪙 Credits: {self.credits}")
            print("=" * 50)

            print("👉 [1] EXPLORE (Scan the area for items, logs, or hazards)")
            print("👉 [2] DIALOGUE (Commune with local inhabitants)")
            print("👉 [3] ENGAGE BOSS (Locate and fight the sector threat)")
            print("👉 [4] NAVIGATE (Travel to a different sector)")
            print("👉 [5] QUIT GAME")
            print("=" * 50)

            action = input("Select an operations directive (1-5): ").strip()

            if action == "1":
                print("\n🔍 Running sector scan...")
                result = self.exploration_roll()
                print(result)


            elif action == "2":
                print("\n🗣️ Opening communications channel...")
                roll_val, result = self.dialogue_roll()
                print(result)

            elif action == "3":
                boss_key = self.world_map[self.current_area]["boss"]
                if not boss_key:
                    print("\n🛡️ Scan clean. There is no boss signature in this hub.")
                elif self.boss_defeated_for_current_level:
                    print(f"\n✅ The threat in {self.current_area} has already been neutralized.")
                else:
                    self.load_and_fight_boss(boss_key)

            elif action == "4":
                self.travel()

            elif action == "5":
                print("\nShutting down systems. Goodbye, Traveler.")
                break
            else:
                print("\n⚠️ Invalid directive code. Try again.")


