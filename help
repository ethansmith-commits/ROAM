def get_shellshoka():
    return (r"""
                     ||__________
                     |            \_______
                     |  [PLASMA]   _______)===(o) *PEW*
                     |____________/
                     /           \
                 .---'             '---.
                /                       \

               |   __________________    |
               |  /                  \   |
               | |   (o)        (o)   |  |
               |  \                  /   |
               |   '----------------'    |
              /      \____________/       \
             /                             \

            |   /\                     /\   |
            |  /  \                   /  \  |
            | /    |                 |    \ |
            |/     |                 |     \|
                   \                 /
                   /                 \
                  /  _..         .._  \
                 (_.'   \       /   '._)

                         |     |
                         |     |
                         |     |
                         \     /
                            _

""")


def get_jumbie_sprite():
    return (r"""
                     .::'   `::.
                    :::       :::
                    :::  o   o  :::
                    `::.   ^   .::'
                      `::.   .::'      
                        `|   |`        
                    _____|   |_____
                   /     |   |     \

                  |  /\  |___|  /\  |
                  | |  |       |  | |
                  | |  |  [T]  |  | |  
                  |  \/  |===|  \/  |
                   \_____|___|_____/

                         |   |
                         |   |
                         |   |
                         |   |
                         |___|
                        /     \

                       |       |
                        \_____/
""")


def get_raybreeze():
    return (r"""
                       (\.-./)
                       /     \
                     .'   :   '.
                _.-'`     '     `'-._
             .-'          :          '-.
           ,'_.._         .         _.._',
           '`    `'-.     '     .-'`    `'
                     '.   :   .'
                       \_. ._/
                 \       |^|
                  |      | ;
                  \'.___.' /
                   '-....-'  
""")


def display_creature(name, types, art_function):
    print("\n" + "=" * 60)
    print(f"  NAME: {name}")
    print(f"  TYPE: {types}")
    print("=" * 60)
    print(art_function())
    print("=" * 60)
    input("\nPress Enter to return to the main menu...")

if choice_0 != 1:
    print("You chose characters with no pets")
    choice2 = 0  # Gives choice2 a baseline numeric value so the code doesn't crash
else:
    # Keeps choice2 as an integer
    choice2 = int(input("Select a creature to view (1-5) 5 will make you reload the main menu : "))

if choice2 == 1:
    display_creature("FLAMINGO (Pyro Variant)", "Flare / Wind", get_flamingo)
elif choice2 == 2:
    display_creature("SHELLSHOKA", "Steel / Tech", get_shellshoka)
elif choice2 == 3:
    display_creature("JUMBIE SPRITE", "Spirit / Cosmic")
elif choice2 == 4:
    display_creature("RAYBREEZE", "Tide / Wind", get_raybreeze)
elif choice2 == 5:
    print("Reloading main menu...")  # Updated text to match your prompt

