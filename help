import os
import sys  # The restart system
import time
import random


def clear_screen():
    """Clears the terminal screen for a cleaner look."""
    os.system('cls' if os.name == 'nt' else 'clear')


def restart_program():
    """Restarts the current program."""
    print("\nRestarting ROAM...")
    time.sleep(1)
    python = sys.executable
    os.execl(python, python, *sys.argv)


def terminal_loading_screen():
    print("Loading application...")
    total_steps = 50

    for i in range(total_steps + 1):
        percent = (i / total_steps) * 100
        bar = "=" * i + " " * (total_steps - i)
        sys.stdout.write(f"\r[{bar}] {percent:.0f}%")
        sys.stdout.flush()
        time.sleep(0.01)  # Speed up slightly for testing
    print("\nLoad complete!")
    time.sleep(0.5)


# --- GAME REGISTRATION & VALIDATION ---
clear_screen()
username = input("Enter username you would like to be referred to when interacting with NPCs: ")

try:
    age = int(input("Enter your age (must use number or game will not run): "))
except ValueError:
    print("Invalid age format! Exiting game...")
    sys.exit()

pegi = 16

# Check age rating
if age < pegi:
    print("You are too young! Exiting game...")
    sys.exit()  # Safely closes the program


class RPGGameEngine:
    def __init__(self, player_race, current_area):
        self.player_race = player_race.lower()  # Standardised for easier logic comparisons
        self.current_area = current_area

    def roll_dice(self, sides):
        return random.randint(1, sides)

    def combat_roll(self, is_boss_fight=False):
        roll = self.roll_dice(20)
        if is_boss_fight:
            roll -= 3  # Boss fights are inherently harder
        return max(1, roll)

    def exploration_roll(self):
        """Decides exploration depth or hazards via dice rolling."""
        return self.roll_dice(10)

    def dialogue_roll(self):
        """
        Handles Dialogue Rolls with Race and Area modifiers.
        Rolls an 8-sided die.
        """
        roll = self.roll_dice(8)
        modifier = 0


