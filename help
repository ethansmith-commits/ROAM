species_data = {
    "1": {
        "name": "Human", 
        "perk": "Adaptability (+20 Max Health)", 
        "hp": 120, 
        "energy": 100,
        "description": "Standard organic biology. Balanced stats with enhanced long-term durability."
    },
    "2": {
        "name": "Hybrid", 
        "perk": "Symbiosis (+15 Base Attack)", 
        "hp": 100, 
        "energy": 100,
        "description": "Part organic, part unknown. Aggressive mutations grant powerful physical offensive damage."
    },
    "3": {
        "name": "Cyborg", 
        "perk": "Overclock (Efficiency, costs less Energy to move)", 
        "hp": 110, 
        "energy": 120,
        "description": "Mechanically enhanced lifeform. Massive energy storage capacity and robotic efficiency."
    },
    "4": {
        "name": "Alien", 
        "perk": "Plasma Shield (Blocks 15% incoming damage)", 
        "hp": 90, 
        "energy": 110,
        "description": "Extraterrestrial traveler. Physically frail but shielded by unique spatial technology."
    }
}

if __name__ == "__main__":
    terminal_loading_screen()
    clear_screen()
    
    print("=========================================")
    print(f"           WELCOME TO ROAM, {username.upper()}           ")
    print("=========================================\n")
    
    # Selection Flow
    print("Select your Origin Species:")
    for key, info in species_data.items():
        print(f" [{key}] {info['name']} - {info['perk']}")
        print(f"     └ {info['description']}")
    
    choice = input("\nChoose your species index (1-4): ").strip()
    if choice not in species_data:
        print("Invalid alignment choice! Defaulting to Human lineage.")
        choice = "1"
        
    player_species = species_data[choice]
    
    # Initialize Player Session Attributes
    player_hp = player_species["hp"]
    player_max_hp = player_species["hp"]
    player_energy = player_species["energy"]
    player_max_energy = player_species["energy"]
    credits = 100
    location = "Sector 0 - Command Hub"
    
    clear_screen()
    print("--- CHARACTER INITIALISED ---")
    print(f"Name:     {username}")
    print(f"Species:  {player_species['name']}")
    print(f"Trait:    {player_species['perk']}")
    print(f"Health:   {player_hp}/{player_max_hp}")
    print(f"Energy:   {player_energy}/{player_max_energy}")
    print(f"Credits:  {credits} CR")
    print("-----------------------------\n")
    time.sleep(2)

    # --- MAIN ENGINE LOOP ---
    while True:
        if player_hp <= 0:
            print("\n*** CRITICAL FAILURE: Your life signs have flatlined. ***")
            action = input("Press [R] to restart ROAM or [E] to exit: ").lower()
            if action == 'r':
                restart_program()
            else:
                print("Goodbye traveler.")
                sys.exit()

        print(f"\n[ Location: {location} | HP: {player_hp}/{player_max_hp} | Energy: {player_energy}/{player_max_energy} | Credits: {credits} CR ]")
        print("What would you like to do?")
        print(" 1. Scavenge Surrounding Sector (Costs 20 Energy)")
        print(" 2. Rest at Command Pod (Restores 40 Energy & 20 HP)")
        print(" 3. Access Status Terminal")
        print(" 4. Reboot Game Engine")
        print(" 5. Disconnect / Exit")
        
        cmd = input("\nEnter selection (1-5): ").strip()
        
        if cmd == "1":
            clear_screen()
            # Dynamic movement expenditure rule based on Cyborg trait
            energy_cost = 10 if player_species["name"] == "Cyborg" else 20
            
            if player_energy < energy_cost:
                print("❌ Insufficient energy resources! Rest up first.")
                continue
                
            player_energy -= energy_cost
            print(f"⚡ Spent {energy_cost} Energy searching the wasteland...")
            time.sleep(1.5)
            
            # Random event generation
            outcome = random.choice(["loot", "hazard", "empty"])
            if outcome == "loot":
                found_credits = random.randint(25, 75)
                credits += found_credits
                print(f"💰 Success! You discovered hidden technology cache worth {found_credits} Credits.")
            elif outcome == "hazard":
                damage = random.randint(15, 30)
                # Apply structural armor mitigations
                if player_species["name"] == "Alien":
                    damage = int(damage * 0.85)
                    print("🛡️ Your Plasma Shield absorbed a portion of the incoming blast!")
                player_hp -= damage
                print(f"💥 Hazard! You triggered an abandoned automated security node and suffered {damage} damage.")
            else:
                print("💨 The sector is picked clean. You found nothing but stardust.")
                
        elif cmd == "2":
            clear_screen()
            player_energy = min(player_max_energy, player_energy + 40)
            player_hp = min(player_max_hp, player_hp + 20)
            print("🛏️ You dock inside the pod. Vital systems are regenerating...")
            time.sleep(1.5)
            print("Status updated.")
            
        elif cmd == "3":
            clear_screen()
            print("=== SYSTEMS CONFIGURATION TERMINAL ===")
            print(f"Pilot ID:       {username}")
            print(f"Species Gen:    {player_species['name']}")
            print(f"Chassis Integrity: {player_hp}/{player_max_hp}")
            print(f"Power Core:     {player_energy}/{player_max_energy}")
            print(f"Financial Net:  {credits} CR")
            print(f"Perk Mod:       {player_species['perk']}")
            print("======================================")
            input("\nPress Enter to exit terminal...")
            clear_screen()
            
        elif cmd == "4":
            restart_program()
            
        elif cmd == "5":
            print("\nShutting down matrix interface... Safe travels.")
            sys.exit()
            
        else:
            print("Invalid sequence input.")
