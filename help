import random


class RPGGameEngine:
    def __init__(self, player_race, current_area):
        self.player_race = player_race
        self.current_area = current_area

    def roll_dice(self, sides):
        return random.randint(1, sides)

    def combat_roll(self, is_boss_fight=False):
        # Placeholder to prevent errors in simulation
        return "Combat roll simulated."

    def exploration_roll(self):
        # Placeholder to prevent errors in simulation
        return "Exploration roll simulated."

    def dialogue_roll(self):
        """
        Handles Dialogue Rolls with Race and Area modifiers.
        Rolls an 8-sided die.
        """
        roll = self.roll_dice(8)
        modifier = 0

        # --- Adjusted Modifier Logic based on your actual races ---
        # Example logic: Aliens struggle in human territory, Humans thrive there.
        if self.player_race == "alien" and self.current_area == "Trinidad Village":
            modifier = -2  # High distrust for aliens in human areas
        elif self.player_race == "human" and self.current_area == "Trinidad Village":
            modifier = 1  # Humans get a bonus in their own village
        elif self.player_race == "hybrid":
            modifier = -1  # Hybrids are generally hated by all except other hybrids

        final_roll = max(1, min(8, roll + modifier))  # Keeps the result between 1 and 8

        result = f"Dialogue Roll: {roll} (Final: {final_roll} with modifiers) -> "
        if final_roll <= 2:
            result += f"The NPC distrusts you (influenced by your race: {self.player_race} and area: {self.current_area}). COMBAT INITIATED!"
        elif final_roll <= 4:
            result += "Neutral response. The NPC treats you carefully."
        elif final_roll <= 6:
            result += "Success! The NPC gives you a quest item or vital info."
        elif final_roll == 7:
            result += "Great Success! The NPC guides you directly to a new weapon!"
        elif final_roll == 8:
            result += "Perfect Success! The NPC guides you to a health recovery spot!"
def CR():
    return(r"""
Dice Mechanics Combat Rolls (D8)
1–2: Miss / enemy hits
3–4: Normal hit
5: Strong hit
6: Critical hit + ability trigger
7-8 boss fight
""")

def ER():
    return(r"""
Low roll: Hazard or enemy encounter 
Mid roll: Neutral event finding an NPC
High roll: Rare item, creature, or lore discover
""")

def DR():
    return(r"""
1–2 NPC distrusts you can be high chance of combat
3–4 Neutral can be higher chance depending on race and area 
n5–6 NPC gives quest item or info
Npc guides your to a weapon
n8 Npc guides you to health
""")

