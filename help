def show_human_hero():# definning human
    return {
        "faction": "Human",
        "title": "Child Of The Tide",
        "lore": "A descendant of ancient Caribbean guardians. Their teachings are passed down from generation to generation.",
        "strengths": "Nature affinity, Diplomacy, Creature bonding, Passive to humans.",
        "weaknesses": "lower tech resistance, Least passive to aliens, tech attacks.",
        "ability": "Soul Wave (This allows the user to calm down hostile creatures)."
    }


def show_hybrid_hero():# defining hybrid
    return {
        "faction": "Hybrid",
        "title": "The Alone",
        "lore": "Half human, half extraterrestrial, infused with cutting-edge coral tech.",
        "strengths": "Really good stats. Able to traverse all lands. Passive to Hybrids.",
        "weaknesses": "Abilities cost more energy. Hated by all except hybrids. Spiritual attacks.",
        "ability": "Morph Tide (Temporarily allows the user to become one of the other 4 characters)."
    }


def show_cyborg_hero():# defining cyborg
    return {
        "faction": "Cyborg",
        "title": "Chrome Mariner",
        "lore": "Built from coral tech and nanometal salvaged from the old world.",
