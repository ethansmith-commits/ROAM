# Unified setup configuration dictionary data maps
profile_specs = {
    "1": {"race": "human", "hp": 80, "energy": 50, "art": human_art()},
    "2": {"race": "hybrid", "hp": 120, "energy": 70, "art": hybrid_art()},
    "3": {"race": "cyborg", "hp": 150, "energy": 40, "art": cyborg_art()},
    "4": {"race": "alien", "hp": 70, "energy": 90, "art": alien_art()},
}

choice_0 = input("Select a Hero profile to view (1-4 anything else takes you back): ").strip()

if choice_0 not in profile_specs:
    print("Invalid alignment choice! Defaulting to Human lineage.")
    choice_0 = "1"

target_spec = profile_specs[choice_0]
if choice_0 == "1":
    display_hero("human", username, "A descendant of ancient Caribbean guardians...", "Nature affinity...",
                 "Lower tech...", "Soul wave...", target_spec["art"])
elif choice_0 == "2":
    display_hero("hybrid", username, "Half human, half extraterrestrial...", "Good stats...", "High energy cost...",
                 "Morph tide...", target_spec["art"])
elif choice_0 == "3":
    display_hero("cyborg", username, "Built from coral tech and nanometal...", "High Defense...",
                 "Water vulnerability...", "Pulse scan...", target_spec["art"])
elif choice_0 == "4":
    display_hero("alien", username, "Crash-landed near Trinidad's floating reef...", "Telepathy...",
                 "Fauna vulnerability...", "Astral echo...", target_spec["art"])

    # Instantiate player engine data dynamically tracking choice index allocations
game = RPGGameEngine(player_race=target_spec["race"],
                     base_stats={"hp": target_spec["hp"], "energy": target_spec["energy"]})

clear_screen()
print("--- CHARACTER INITIALISED ---")
print(f"Name:     {username}")
print(f"Species:  {game.player_race.upper()}")
