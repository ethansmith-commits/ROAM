if player_energy < energy_cost:
    print("❌ Insufficient energy resources! Rest up first.")

player_energy -= energy_cost
print(f"⚡ Spent {energy_cost} Energy searching the wasteland...")
time.sleep(1.5)

 # Random event generation
outcome = random.choice(["loot", "hazard", "empty"])
if outcome == "loot":
   found_credits = random.randint(25, 75)
   credits += found_credits
   print(f"💰 Success! You discovered hidden technology cache worth {found_credits} Credits.")
elif outcome == "hazard":
    damage = random.randint(15, 30)
    # Apply structural armor mitigations
if player_species["name"] == "Alien":
    damage = int(damage * 0.85)
    print("🛡️ Your Plasma Shield absorbed a portion of the incoming blast!")
    player_hp -= damage
    print(f"💥 Hazard! You triggered an abandoned automated security node and suffered {damage} damage.")
else:
    print("💨 The sector is picked clean. You found nothing but stardust.")


